{% if product %}
  <div class="mtm-customizer" data-mtm-root data-proxy-base="{{ block.settings.proxy_path | escape }}">
    <script type="application/json" data-mtm-product-context>
      {"productId":{{ product.id | json }},"selectedVariantId":{{ product.selected_or_first_available_variant.id | json }},"variants":[{% for variant in product.variants %}{"id":{{ variant.id | json }},"sku":{{ variant.sku | json }},"title":{{ variant.title | json }},"available":{{ variant.available | json }},"price":{{ variant.price | json }}}{% unless forloop.last %},{% endunless %}{% endfor %}]}
    </script>
    <button type="button" class="mtm-customizer__trigger" data-mtm-open hidden>{{ block.settings.fallback_label }}</button>
    <dialog class="mtm-customizer__dialog" data-mtm-dialog aria-labelledby="mtm-title-{{ block.id }}">
      <form method="dialog" class="mtm-customizer__panel">
        <header><h2 id="mtm-title-{{ block.id }}" data-mtm-title>{{ block.settings.fallback_label }}</h2><button value="cancel" aria-label="关闭">×</button></header>
        <div data-mtm-content></div>
        <p class="mtm-customizer__error" data-mtm-error role="alert"></p>
        <footer><button type="button" data-mtm-submit>确认定制并加入购物车</button></footer>
      </form>
    </dialog>
  </div>
{% endif %}

{% schema %}
{"name":"MTM 商品定制","target":"section","enabled_on":{"templates":["product"]},"javascript":"mtm-customizer.js","stylesheet":"mtm-customizer.css","settings":[{"type":"text","id":"proxy_path","label":"App Proxy 路径","default":"/apps/mtm-config"},{"type":"text","id":"fallback_label","label":"默认按钮文字","default":"开始定制"}]}
{% endschema %}
